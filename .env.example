# ====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Hệ thống Tiếp nhận & Điều phối Đơn thư - UBND Tỉnh Đồng Nai
# ====================================================================

# --------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU (DATABASE)
# Mặc định sử dụng SQLite cục bộ, hoặc kết nối MS SQL Server
# --------------------------------------------------
# SQLite (Khuyên dùng khi chạy thử nghiệm nhanh):
DATABASE_URL=sqlite:///./dongnai_civic.db

# MS SQL Server (Dành cho môi trường Production / Diễn tập):
# DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS02/DongNaiCivicDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
DB_SERVER=localhost\SQLEXPRESS02
DB_NAME=DongNaiCivicDB
DB_DRIVER=ODBC Driver 18 for SQL Server

# --------------------------------------------------
# 2. CẤU HÌNH TRÍ TUỆ NHÂN TẠO GEMINI (AI ENGINE)
# --------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# --------------------------------------------------
# 3. TIẾP NHẬN & PHẢN HỒI EMAIL CÔNG VỤ (IMAP / SMTP)
# --------------------------------------------------
MAIL_SERVER=imap.gmail.com
MAIL_PORT=993
MAIL_USERNAME=tiepnhan.ykien@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_SENDER_NAME="Hệ thống Tiếp nhận Đơn thư Đồng Nai"

# Cấu hình SMTP phát hành thông báo chính thức
MAIL_SMTP_SERVER=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_CHECK_INTERVAL_SECONDS=60

# Tương thích ngược với các biến EMAIL_*
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ACCOUNT=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_CHECK_INTERVAL_SECONDS=60

# --------------------------------------------------
# 4. XÁC THỰC GOOGLE OAUTH2 (TÙY CHỌN)
# --------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --------------------------------------------------
# 5. CẤU HÌNH FRONTEND (CLIENT)
# Để trống để sử dụng Vite Proxy tự động (/api)
# --------------------------------------------------
VITE_API_URL=""

